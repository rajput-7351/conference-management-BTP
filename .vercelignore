# ============================================
# VERCEL IGNORE — Frontend deployment only
# Vercel should ONLY bundle HTML/JS/CSS assets
# ============================================

# Python AI Backend (deployed separately on Render)
ai-backend/
*.py
*.pyc
__pycache__/

# Python virtual environments (HUGE — never deploy)
venv/
env/
.venv/
**/venv/
**/env/
**/.venv/

# Node dependencies (Vercel installs fresh)
node_modules/

# Vite build output (Vercel builds fresh from source)
dist/

# Large binary/data files not needed for frontend
btp sample report/
screenshot and chat data/
report.tex
*.pdf
*.tex
*.csv

# Config files for other services
render.yaml
PROJECT_DOCUMENTATION.md
README.md

# OS and editor artifacts
.DS_Store
Thumbs.db
*.log
